# Build output and dependencies — everything here is regenerated by
# `npm install`, `npm run build` and `dotnet build`.
node_modules/
dist/
bin/
obj/
.vite/

# The SQLite database is created and seeded on first run.
*.db
*.db-shm
*.db-wal

# Local secrets. The OpenRouter key belongs in an environment variable or in
# user-secrets, not in a file that travels with the folder.
appsettings.Local.json
appsettings.Development.json
.env
.env.local

.DS_Store
Thumbs.db

# Local tooling and publish output.
.claude/
publish/
